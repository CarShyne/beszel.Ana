# Stage 1: build embedded web UI (required for //go:embed dist)
FROM node:22-alpine AS web
WORKDIR /web
COPY internal/site/package.json internal/site/package-lock.json ./
RUN npm ci
COPY internal/site/ ./
RUN npm run build

# Stage 2: build hub binary
FROM --platform=$BUILDPLATFORM golang:alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . ./

# Embed frontend from stage 1
COPY --from=web /web/dist ./internal/site/dist

RUN apk add --no-cache unzip ca-certificates
RUN update-ca-certificates

ARG TARGETOS TARGETARCH
RUN CGO_ENABLED=0 GOGC=75 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -ldflags "-w -s" -o /anarchy-pulse ./internal/cmd/hub

FROM scratch

COPY --from=builder /anarchy-pulse /
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

VOLUME ["/anarchy_pulse_data"]

EXPOSE 8090

ENTRYPOINT [ "/anarchy-pulse" ]
CMD ["serve", "--http=0.0.0.0:8090"]
